# ─── Supabase ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PUBLIC_SITE_URL=https://riftascendant.vercel.app

# ─── Dedicated Sovereign generation — SERVER ONLY ──────────────────────
# A1 removed general-purpose AI. /api/sovereign is the only provider-backed
# product path. These variables are read only by server-side provider code;
# never add a VITE_ prefix or expose provider credentials to browser code.
#
# Provider order is optional. Each configured provider is used only by the
# dedicated authenticated Sovereign generator.
# AI_PROVIDER_ORDER=gemini,openrouter,pollinations

# Google Gemini (optional server-side provider)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# OpenRouter (optional server-side fallback)
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Pollinations is the optional keyless text fallback used by the server chain.
# POLLINATIONS_MODEL=openai

# Supabase service-role key (required server-side for /api/createInvite).
# Keep this SECRET — server-only. Never use VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional CORS restriction for server endpoints.
# ALLOWED_ORIGIN=https://your-app.vercel.app

# ─── Guest Mode ─────────────────────────────────────────────────────────
# VITE_GUEST_ENABLED=true
